modified: 20240720053946580
tags: 
title: Custom Tags
type: text/vnd.tiddlywiki
state: $:/lls/state/customTags

\import $:/plugins/midorum/lls/procedures/lls-user-tag
\parameters (
 state:"$:/temp/lls/state/customTagsForm",
 tagNameEditIndex:"tagNameEdit",
 tagDescriptionEditIndex:"tagDescriptionEdit",
 presetTagNameField:"tagName",
)

\procedure createUserTagAction()
<$list
 variable=userTagName
 filter="[<state>getindex<tagNameEditIndex>else<preset>]"
><$set
 name="userTagDescritpion"
 tiddler=<<state>>
 index=<<tagDescriptionEditIndex>>
><$action-sendmessage 
 $message="tm-lls-create-user-tag" 
 name=<<userTagName>>
 description=<<userTagDescritpion>>
/></$set></$list><$transclude
 $variable="clearFormAction"
/>
\end createUserTagAction

\procedure clearFormAction()
<$action-setfield
 $tiddler=<<state>>
 $index=<<tagNameEditIndex>>
/><$action-setfield
 $tiddler=<<state>>
 $index=<<tagDescriptionEditIndex>>
/><$action-setfield 
 $tiddler={{!!state}}
 $field=<<presetTagNameField>>
/>
\end clearFormAction

\procedure newUserTagBlock()
<h2>Create new Custom Tag</h2><p><div><$text
 text="Tag Name"
/></div><div><$edit-text
 tiddler=<<state>>
 index=<<tagNameEditIndex>>
 tag="input"
 default=<<preset>>
/></div></p><p><div><$text
 text="Tag Description"
/></div><div><$edit-text
 tiddler=<<state>>
 index=<<tagDescriptionEditIndex>>
 default=""
 size="50"
/></div></p><p><div><$button
 actions=<<createUserTagAction>>
>Create</$button></div></p>
\end newUserTagBlock

\procedure focus()
<$action-sendmessage 
 $message="tm-lls-attach-user-focus" 
 ref=<<currentTiddler>>
/>
\end focus

\procedure userFocusBlock()
<$transclude
 $variable="list-tagged-draggable"
 tag="$:/lls/tags/userTag"
 subFilter="tag[$:/lls/tags/userFocus]"
 itemTemplate="$:/plugins/midorum/lls/ui/templates/userTagFocusedDraggable"
 elementTag="p"
><$fill
 $name=button
></$fill>
</$transclude>
\end userFocusBlock

\procedure userTagListBlock()
<$list
 filter="[!has[draft.of]tag[$:/lls/tags/userTag]!tag[$:/lls/tags/userFocus]sort[name]]"
><p><$transclude
    $variable="lls-user-tag-popup" 
    tagRef=<<currentTiddler>>
/> - <$view
    field="text"
/> <$button
 class="tc-btn-invisible tc-tiddlylink"
 actions=<<focus>>
>[focus]</$button></p></$list>
\end userTagListBlock

<!----------------- content --------------------->
<$set
 name=this
 value=<<currentTiddler>>
><$set
 name=preset
 tiddler={{!!state}}
 field=<<presetTagNameField>>
><$transclude
 $variable="newUserTagBlock"
/><h2>Focused Tags</h2><$transclude
 $variable="userFocusBlock"
/><h2>Other Tags</h2><$transclude
 $variable="userTagListBlock"
/>
</$set></$set>