modified: 20240711042928729
tags: 
title: Custom Tag View
type: text/vnd.tiddlywiki
state: $:/lls/state/customTagView

\parameters (
 usageExampleViewState:"$:/temp/lls/state/customTagView"
)

\procedure userTagInfoSection()
<h2><$transclude
 $tiddler=<<ref>>
 $field="name"
/></h2><$transclude
 $tiddler=<<ref>>
 $field="text"
/>
\end userTagInfoSection

\procedure linkedEntitiesSection()
<h3>Tagged Words</h3>
<$list
 filter="[tag<ref>tag[$:/lls/tags/wordArticle]]"
><$transclude
 $variable="wordArticleEntry"
 _ref=<<currentTiddler>>
 $mode=block
/></$list>
<h3>Tagged Usage Examples</h3>
<$list
 filter="[tag<ref>tag[$:/lls/tags/usageExample]]"
><$transclude
 $variable="usageExampleEntry"
 _ref=<<currentTiddler>>
 $mode=block
/></$list>
\end linkedEntitiesSection

\procedure wordArticleEntry(_ref)
<$list
 filter="[<_ref>tags[]tag[$:/lls/tags/word]]"
><$transclude
 $variable="openWordEditorFormLink"
 ref=<<currentTiddler>>
 text={{!!text}}
 $mode=inline
/></$list><$text
 text=" - "
/><$list
 filter="[<_ref>tags[]tag[$:/lls/tags/wordMeaning]]"
><$transclude
 $field=text
/></$list>
\end wordArticleEntry

\procedure usageExampleEntry(_ref)
<$transclude
 $tiddler=<<_ref>>
 $field="original"
/><$transclude
 $variable="openExampleViewFormLink"
 ref=<<_ref>>
 text="[view]"
/>
\end usageExampleEntry

<!----------------- content --------------------------->

<$vars this=<<currentTiddler>>>
<$set
 name="ref"
 tiddler={{!!state}}
>
<div class="custom-tag-view-form">

<h3>Tag Name and Description</h3>

<$transclude
 $variable="userTagInfoSection"
 someParameter="parameter value"
/>

<$transclude
 $variable="linkedEntitiesSection"
/>

</div>
</$set>
</$vars>